## Enhanced Cloudflare Pages Security Headers
## This is your UPDATED _headers file

# Global headers - Apply to all pages
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://esm.sh https://cdn.jsdelivr.net https://challenges.cloudflare.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://esm.sh https://cdn.jsdelivr.net https://challenges.cloudflare.com https://fonts.googleapis.com https://fonts.gstatic.com; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:;
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), usb=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block

# Static assets - Aggressive caching
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML pages - Short cache so edits show quickly
/*
  Cache-Control: public, max-age=300

# API endpoints - No caching, extra security
/api/*
  Cache-Control: no-store, no-cache, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# Admin pages - Maximum security
/admin/*
  X-Frame-Options: DENY
  Cache-Control: no-store, no-cache, must-revalidate, private
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff

# QR Proxy tool - Special handling for sandbox
/tools/qr-tester.html
  X-Frame-Options: DENY

# Images and media
/images/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: cross-origin

# CSS and JS
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

# Blog content - Allow some sharing
/pages/blog/*
  X-Frame-Options: SAMEORIGIN
  Cache-Control: public, max-age=3600