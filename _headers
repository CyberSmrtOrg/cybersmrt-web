# Global headers - Apply to all pages
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://esm.sh https://cdn.jsdelivr.net https://challenges.cloudflare.com https://cdnjs.cloudflare.com https://www.googletagmanager.com https://static.cloudflareinsights.com https://www.clarity.ms https://scripts.clarity.ms; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https://esm.sh https://cdn.jsdelivr.net https://challenges.cloudflare.com https://fonts.googleapis.com https://fonts.gstatic.com https://api.cybersmrt.org https://auth.cybersmrt.org https://profile.cybersmrt.org https://imagedelivery.net https://www.googletagmanager.com https://www.google-analytics.com https://cloudflareinsights.com https://www.clarity.ms https://scripts.clarity.ms; frame-src 'self' https://challenges.cloudflare.com; worker-src 'self' blob:;
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), usb=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Cache-Control: public, max-age=300

# Static assets - Aggressive caching (1 year)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000

# Fonts - Long-term caching with CORS
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: cross-origin
  Access-Control-Allow-Origin: *
  CDN-Cache-Control: public, max-age=31536000

# Images and media - Long-term caching
/assets/images/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: cross-origin
  CDN-Cache-Control: public, max-age=31536000

/assets/logos/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: cross-origin
  Access-Control-Allow-Origin: *
  CDN-Cache-Control: public, max-age=31536000

/images/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: cross-origin
  CDN-Cache-Control: public, max-age=31536000

# CSS and JS - Long-term caching
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000

/assets/js/*
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000

/css/*
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000

/js/*
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000

# Static file types - Long-term caching
/*.woff
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: cross-origin
  Access-Control-Allow-Origin: *
  CDN-Cache-Control: public, max-age=31536000

/*.woff2
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: cross-origin
  Access-Control-Allow-Origin: *
  CDN-Cache-Control: public, max-age=31536000

/*.ttf
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: cross-origin
  Access-Control-Allow-Origin: *
  CDN-Cache-Control: public, max-age=31536000

/*.otf
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: cross-origin
  Access-Control-Allow-Origin: *
  CDN-Cache-Control: public, max-age=31536000

/*.svg
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000

/*.png
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000

/*.jpg
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000

/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000

/*.gif
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000

/*.webp
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000

/*.ico
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000

# API endpoints - No caching, extra security
/api/*
  Cache-Control: no-store, no-cache, must-revalidate
  CDN-Cache-Control: no-store
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# Admin pages - Maximum security, no caching
/admin/*
  X-Frame-Options: DENY
  Cache-Control: no-store, no-cache, must-revalidate, private
  CDN-Cache-Control: no-store
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff

# Auth and profile pages - No caching for dynamic content
/login.html
  Cache-Control: no-store, no-cache, must-revalidate
  CDN-Cache-Control: no-store

/register.html
  Cache-Control: no-store, no-cache, must-revalidate
  CDN-Cache-Control: no-store

/profile.html
  Cache-Control: no-store, no-cache, must-revalidate
  CDN-Cache-Control: no-store

/callback.html
  Cache-Control: no-store, no-cache, must-revalidate
  CDN-Cache-Control: no-store

# QR Proxy tool - Special handling for sandbox
/tools/qr-tester.html
  X-Frame-Options: DENY

# Blog content - Short-term caching (1 hour)
/pages/blog/*
  X-Frame-Options: SAMEORIGIN
  Cache-Control: public, max-age=3600
  CDN-Cache-Control: public, max-age=3600
